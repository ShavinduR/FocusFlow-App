NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/focusflow
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=30d
# Comma-separated list of allowed web origins (native apps send no Origin header)
CORS_ORIGINS=http://localhost:8081
